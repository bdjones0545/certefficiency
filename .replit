modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
CSCS_COURSE_PRICE_ID = "price_1TxY3ODxkszsDI2lmMUOM9KJ"

[userenv.shared]
ALLOWED_ORIGINS = "https://certefficiency.com,https://www.certefficiency.com"
NODE_ENV = "production"
SARAH_MAX_RETRIES = "3"
SARAH_TIMEOUT_MS = "120000"

[nix]
channel = "stable-25_05"
